# AEO Command — Environment Variables
# Copy to .env.local or set in host dashboard. Never commit secrets.

# ── Required ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/aeo_command?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Crawl + AI analysis ───────────────────────────────
ANTHROPIC_API_KEY=""
FIRECRAWL_API_KEY=""

# ── Live visibility engines (Phase 13.4 — all optional) ─
# Perplexity (citations) · OpenAI (ChatGPT-style) · Gemini · Claude
PERPLEXITY_API_KEY=""
OPENAI_API_KEY=""
# OPENAI_VISIBILITY_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
# or GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_VISIBILITY_MODEL="gemini-2.0-flash"
# ANTHROPIC_VISIBILITY_MODEL="claude-3-5-haiku-latest"
# (ANTHROPIC_API_KEY above is reused for Claude visibility)

# ── Durable jobs (Inngest) ─────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# INNGEST_DEV=1

# ── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="AEO Command <onboarding@resend.dev>"

# ── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Seed SUPER_ADMIN (db:seed only) ────────────────────
# SEED_SUPER_ADMIN_EMAIL="you@threezero.agency"
# SEED_SUPER_ADMIN_PASSWORD="min-12-chars-long-password"
# SEED_SUPER_ADMIN_NAME="Super Admin"

# ── Visibility snapshot hardening (P0-A) ───────────────
# HTTP rate limit: max starts per agency per window
# VISIBILITY_SNAPSHOT_RATE_LIMIT=5
# VISIBILITY_SNAPSHOT_RATE_WINDOW_MS=600000
# Monthly AI visibility ops budget (1 op ≈ 1 live provider call)
# VISIBILITY_OPS_MONTHLY_LIMIT=2000
# Inngest concurrency
# VISIBILITY_GLOBAL_CONCURRENCY=5
# VISIBILITY_AGENCY_CONCURRENCY=1
# Parallel prompts inside one job
# VISIBILITY_PROMPT_CONCURRENCY=2
# Shared Redis cache + distributed single-flight (required for multi-instance scale)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Visibility provider-result cache TTL (default 6 hours)
# VISIBILITY_CACHE_TTL_SECONDS=21600
# Distributed provider lock TTL (default 45 seconds)
# VISIBILITY_CACHE_LOCK_SECONDS=45

# ── Provider concurrency + timeout hardening (P0-C) ─────
# Max simultaneous live provider calls across the deployment
# VISIBILITY_GLOBAL_PROVIDER_CONCURRENCY=12
# Max simultaneous calls to one provider/engine
# VISIBILITY_PROVIDER_CONCURRENCY=4
# Max simultaneous live provider calls attributable to one agency
# VISIBILITY_AGENCY_PROVIDER_CONCURRENCY=4
# Lease must outlive the provider HTTP timeout
# VISIBILITY_CONCURRENCY_LEASE_MS=30000
# How long a prompt waits for a provider slot
# VISIBILITY_CONCURRENCY_WAIT_MS=20000
# Poll interval while waiting for a slot
# VISIBILITY_CONCURRENCY_POLL_MS=250
# Production defaults to true; fail closed if distributed Redis is unavailable
# VISIBILITY_CONCURRENCY_REQUIRE_REDIS=1
# Hard timeout for one provider HTTP request
# VISIBILITY_PROVIDER_TIMEOUT_MS=20000


# ── P0-D abuse / rate-limit hardening ───────────────────
# Production defaults to fail closed when distributed Redis is unavailable
# RATE_LIMIT_REQUIRE_REDIS=1
# Timeout for the Redis rate-limit request
# RATE_LIMIT_REDIS_TIMEOUT_MS=1500
# Expensive authenticated endpoint limits
# REPORT_GENERATION_RATE_LIMIT=10
# REPORT_GENERATION_RATE_WINDOW_MS=600000
# ACTION_REDAFT_RATE_LIMIT=10
# ACTION_REDAFT_RATE_WINDOW_MS=600000

# P0-F crawl resource budgets
CRAWL_TIMEOUT_MS=25000
CRAWL_CONNECT_TIMEOUT_MS=10000
CRAWL_MAX_REDIRECTS=5
CRAWL_MAX_RESPONSE_BYTES=5242880
# Firecrawl/provider response and persistence caps
CRAWL_PROVIDER_MAX_RESPONSE_BYTES=5242880
CRAWL_MAX_LINKS_STORED=2000
CRAWL_MAX_METADATA_BYTES=102400


# P0-G global scan admission / execution budgets
SCAN_GLOBAL_BACKLOG_LIMIT=1000
SCAN_AGENCY_BACKLOG_LIMIT=25
SCAN_GLOBAL_EXECUTION_CONCURRENCY=8
SCAN_AGENCY_EXECUTION_CONCURRENCY=2
SCAN_ADMISSION_LOCK_TIMEOUT_MS=1500


# P0-H public auth abuse limits
# Signup already uses a per-IP 5/hour bucket plus per-email 3/hour.
# Password recovery already uses a per-IP 5/hour bucket plus per-email 3/hour.
# Invite acceptance uses a per-IP 10/hour bucket.
# Reset tokens use a hashed-token 10/hour bucket plus the existing per-IP bucket.


# P0-I provider/network cost isolation
# Distributed hourly budgets. Production fail closed if Redis is unavailable.
PROVIDER_BUDGET_WINDOW_MS=3600000
PROVIDER_GLOBAL_CRAWL_BUDGET=500
PROVIDER_AGENCY_CRAWL_BUDGET=60
PROVIDER_GLOBAL_AI_BUDGET=500
PROVIDER_AGENCY_AI_BUDGET=60
# Hard timeout and response cap for paid AI provider calls.
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_RESPONSE_BYTES=1048576


# P0-J database pool guidance
# Set these in the production DATABASE_URL for the actual Postgres capacity.
# Keep the pool bounded per app instance; tune the sum across all app/worker instances below your managed Postgres capacity.
# For a small deployment, an example starting point is: ?connection_limit=10&pool_timeout=10
# At larger scale, lower per-instance limits rather than multiplying a large pool across every instance.


# P0-M expensive-operation throttles
BILLING_CHECKOUT_RATE_LIMIT=5
BILLING_CHECKOUT_RATE_WINDOW_MS=3600000
BILLING_PORTAL_RATE_LIMIT=10
BILLING_PORTAL_RATE_WINDOW_MS=3600000
BILLING_USAGE_RATE_LIMIT=60
BILLING_USAGE_RATE_WINDOW_MS=60000
TEAM_INVITE_RATE_LIMIT=20
TEAM_INVITE_RATE_WINDOW_MS=3600000
PDF_PER_IP_RATE_LIMIT=30
PDF_PER_TOKEN_RATE_LIMIT=10
PDF_GLOBAL_RATE_LIMIT=300
PDF_RATE_WINDOW_MS=60000


# P0-P stale scan recovery
# Scans RUNNING longer than this are safely marked FAILED by the 5-minute recovery job.
# Minimum 2 minutes, maximum 60 minutes; default 15 minutes.
SCAN_STALE_TIMEOUT_MS=900000

# P0-R Redis guard timeouts (bounded 250ms–5s)
RATE_LIMIT_REDIS_TIMEOUT_MS=1500
VISIBILITY_CONCURRENCY_REDIS_TIMEOUT_MS=1500

# Production must use durable scan queue; set to 1 only for bounded non-production fallback.
ALLOW_IN_PROCESS_SCAN_FALLBACK=0
