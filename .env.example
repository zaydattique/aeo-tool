# AEO Command — Environment Variables
# Copy to .env.local (local) or set in host dashboard (production).
# Never commit real secrets.

# ── Required ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/aeo_command?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
# Production: https://app.threezero.agency
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical public URL (sitemap, invites, OG). Match NEXTAUTH_URL in prod.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional: crawl + AI quality ───────────────────────
ANTHROPIC_API_KEY=""
FIRECRAWL_API_KEY=""

# ── Optional: Stripe billing ───────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Optional: seed SUPER_ADMIN (npm run db:seed only) ─
# SEED_SUPER_ADMIN_EMAIL="you@threezero.agency"
# SEED_SUPER_ADMIN_PASSWORD="min-12-chars-long-password"
# SEED_SUPER_ADMIN_NAME="Super Admin"
