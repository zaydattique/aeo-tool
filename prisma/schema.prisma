// AEO Command — Prisma Schema
// Multi-tenant production schema. Every business table scoped by agencyId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_OWNER
  AGENCY_MEMBER
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  SCANNING
  ERROR
  ARCHIVED
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ScanStage {
  QUEUED
  CRAWL
  EXTRACT
  AI_ANALYSIS
  ACTION_GENERATION
  COMPLETED
  FAILED
}

enum VisibilityJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ActionPriority {
  HIGH
  MEDIUM
  LOW
}

enum ActionCategory {
  TECHNICAL
  CONTENT
  SCHEMA
  ENTITY
  AUTHORITY
  PERFORMANCE
  OTHER
}

enum ActionEffort {
  LOW
  MEDIUM
  HIGH
}

enum ActionStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  INCOMPLETE
}

enum BillingRegion {
  PAKISTAN
  INTERNATIONAL
}

model Plan {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  region              BillingRegion
  priceMonthly        Int
  currency            String
  maxClients          Int
  maxScansPerMonth    Int
  maxTrackedPrompts   Int
  maxTeamSeats        Int
  whiteLabel          Boolean       @default(false)
  features            Json?
  isActive            Boolean       @default(true)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  agencies            Agency[]
  subscriptions       Subscription[]

  @@index([region, isActive])
  @@index([slug])
}

model Agency {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  logoUrl              String?
  brandColors          Json?
  status               AgencyStatus  @default(TRIAL)
  billingRegion        BillingRegion @default(PAKISTAN)
  planId               String?
  stripeCustomerId     String?
  createdBySuperAdmin  Boolean       @default(false)
  onboardingCompleted  Boolean       @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  plan                 Plan?         @relation(fields: [planId], references: [id])
  users                User[]
  clients              Client[]
  scans                Scan[]
  actions              Action[]
  trackedPrompts       TrackedPrompt[]
  visibilitySnapshots  VisibilitySnapshot[]
  reports              Report[]
  teamInvites          TeamInvite[]
  activityLogs         ActivityLog[]
  subscriptions        Subscription[]
  usageMeters          UsageMeter[]
  visibilityJobs       VisibilityJob[]

  @@index([status])
  @@index([deletedAt])
  @@index([planId])
  @@index([stripeCustomerId])
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String?
  fullName              String?
  role                  UserRole  @default(AGENCY_MEMBER)
  agencyId              String?
  avatarUrl             String?
  lastLoginAt           DateTime?
  inviteToken           String?   @unique
  inviteExpiresAt       DateTime?
  passwordResetToken    String?   @unique
  passwordResetExpires  DateTime?
  emailVerified         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  agency                Agency?   @relation(fields: [agencyId], references: [id])
  assignedActions       Action[]  @relation("ActionAssignee")
  completedActions      Action[]  @relation("ActionCompleter")
  generatedReports      Report[]  @relation("ReportGenerator")
  activityLogs          ActivityLog[]
  teamInvitesSent       TeamInvite[] @relation("InviteSender")

  @@index([agencyId])
  @@index([deletedAt])
  @@index([role])
  @@index([passwordResetToken])
}

model Client {
  id                     String       @id @default(cuid())
  agencyId               String
  name                   String
  websiteUrl             String
  brandName              String?
  location               String?
  keywords               String[]
  competitors            String[]
  currentVisibilityScore Int?
  lastScannedAt          DateTime?
  status                 ClientStatus @default(ACTIVE)
  rescanEnabled          Boolean      @default(false)
  rescanIntervalDays     Int          @default(7)
  nextRescanAt           DateTime?
  portalToken            String?      @unique
  portalEnabled          Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  agency                 Agency       @relation(fields: [agencyId], references: [id])
  scans                  Scan[]
  actions                Action[]
  trackedPrompts         TrackedPrompt[]
  visibilitySnapshots    VisibilitySnapshot[]
  visibilityJobs         VisibilityJob[]
  reports                Report[]

  @@index([agencyId])
  @@index([agencyId, deletedAt])
  @@index([status])
  @@index([lastScannedAt])
  @@index([rescanEnabled, nextRescanAt])
  @@index([portalToken])
}

model Scan {
  id              String     @id @default(cuid())
  agencyId        String
  clientId        String
  status          ScanStatus @default(QUEUED)
  stage           ScanStage  @default(QUEUED)
  progress        Int        @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  rawCrawlData    Json?
  aiAnalysis      Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  agency          Agency     @relation(fields: [agencyId], references: [id])
  client          Client     @relation(fields: [clientId], references: [id])
  actions         Action[]

  @@index([agencyId])
  @@index([clientId])
  @@index([agencyId, status])
  @@index([status, createdAt])
  @@index([clientId, status, createdAt])
}

model Action {
  id             String         @id @default(cuid())
  agencyId       String
  clientId       String
  scanId         String?
  priority       ActionPriority @default(MEDIUM)
  category       ActionCategory @default(OTHER)
  title          String
  whyItMatters   String
  steps          Json
  effortLevel    ActionEffort   @default(MEDIUM)
  suggestedText  String?
  status         ActionStatus   @default(TODO)
  assignedToId   String?
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  agency         Agency         @relation(fields: [agencyId], references: [id])
  client         Client         @relation(fields: [clientId], references: [id])
  scan           Scan?          @relation(fields: [scanId], references: [id])
  assignedTo     User?          @relation("ActionAssignee", fields: [assignedToId], references: [id])
  completedBy    User?          @relation("ActionCompleter", fields: [completedById], references: [id])

  @@index([agencyId])
  @@index([clientId])
  @@index([agencyId, status])
  @@index([agencyId, priority])
  @@index([assignedToId])
  @@index([scanId])
  @@index([deletedAt])
}

model TrackedPrompt {
  id             String   @id @default(cuid())
  agencyId       String
  clientId       String
  promptText     String
  isCustom       Boolean  @default(false)
  kind           String   @default("brand")
  targetName     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  agency         Agency   @relation(fields: [agencyId], references: [id])
  client         Client   @relation(fields: [clientId], references: [id])
  snapshots      VisibilitySnapshot[]

  @@index([agencyId])
  @@index([clientId])
  @@index([agencyId, clientId])
  @@index([kind])
  @@index([deletedAt])
}

model VisibilitySnapshot {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String
  promptId    String
  jobId       String?
  score       Decimal  @db.Decimal(5, 2)
  sources     Json?
  recordedAt  DateTime @default(now())

  agency      Agency   @relation(fields: [agencyId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  prompt      TrackedPrompt @relation(fields: [promptId], references: [id])
  job         VisibilityJob? @relation(fields: [jobId], references: [id])

  @@unique([jobId, promptId])
  @@index([agencyId])
  @@index([clientId])
  @@index([promptId])
  @@index([jobId])
  @@index([agencyId, clientId, recordedAt])
}

model VisibilityJob {
  id               String              @id @default(cuid())
  agencyId         String
  clientId         String
  status           VisibilityJobStatus @default(QUEUED)
  progress         Int                 @default(0)
  promptCount      Int                 @default(0)
  opsReserved      Int                 @default(0)
  opsConsumed      Int                 @default(0)
  usageMeterId     String?
  /// Once true, meter settle for this job must not run again (retry-safe)
  usageSettled     Boolean             @default(false)
  liveEngineCount  Int                 @default(0)
  successCount     Int                 @default(0)
  failureCount     Int                 @default(0)
  /// When set, concurrent/duplicate POSTs with same key return this job (same client only)
  idempotencyKey   String?
  /// Non-null only while QUEUED/RUNNING — enables unique active job per client
  activeClientKey  String?
  errorMessage     String?
  resultSummary    Json?
  actorId          String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  agency           Agency              @relation(fields: [agencyId], references: [id])
  client           Client              @relation(fields: [clientId], references: [id])
  usageMeter        UsageMeter?         @relation(fields: [usageMeterId], references: [id])
  snapshots        VisibilitySnapshot[]

  @@unique([agencyId, idempotencyKey])
  @@unique([activeClientKey])
  @@index([agencyId])
  @@index([clientId])
  @@index([agencyId, status])
  @@index([status, createdAt])
  @@index([clientId, status])
}

model Report {
  id              String   @id @default(cuid())
  agencyId        String
  clientId        String
  generatedById   String?
  config          Json?
  pdfUrl          String?
  liveLinkToken   String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  agency          Agency   @relation(fields: [agencyId], references: [id])
  client          Client   @relation(fields: [clientId], references: [id])
  generatedBy     User?    @relation("ReportGenerator", fields: [generatedById], references: [id])

  @@index([agencyId])
  @@index([clientId])
  @@index([liveLinkToken])
  @@index([deletedAt])
}

model TeamInvite {
  id          String    @id @default(cuid())
  agencyId    String
  email       String
  role        UserRole  @default(AGENCY_MEMBER)
  token       String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  agency      Agency    @relation(fields: [agencyId], references: [id])
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([agencyId])
  @@index([token])
  @@index([email])
  @@unique([agencyId, email])
}

model ActivityLog {
  id           String   @id @default(cuid())
  agencyId     String?
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ip           String?
  createdAt    DateTime @default(now())

  agency       Agency?  @relation(fields: [agencyId], references: [id])
  actor        User?    @relation(fields: [actorId], references: [id])

  @@index([agencyId])
  @@index([actorId])
  @@index([agencyId, createdAt])
  @@index([resourceType, resourceId])
}

model Subscription {
  id                   String             @id @default(cuid())
  agencyId             String
  planId               String
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  agency               Agency             @relation(fields: [agencyId], references: [id])
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([agencyId])
  @@index([planId])
  @@index([status])
}

model UsageMeter {
  id                     String   @id @default(cuid())
  agencyId               String
  periodStart            DateTime
  periodEnd              DateTime
  clientsCount           Int      @default(0)
  scansUsed              Int      @default(0)
  promptsUsed            Int      @default(0)
  reportsGenerated       Int      @default(0)
  visibilityOpsUsed      Int      @default(0)
  visibilityOpsReserved  Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  agency            Agency           @relation(fields: [agencyId], references: [id])
  visibilityJobs    VisibilityJob[]

  @@unique([agencyId, periodStart])
  @@index([agencyId])
  @@index([periodStart])
}
